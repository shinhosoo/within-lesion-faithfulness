[bb_run] backbone=resnet50  output_root=$PROJECT_ROOT/outputs_resnet50
PROJECT_ROOT = $PROJECT_ROOT   (the folder holding SkinCancer/)
SPLIT_ROOT   = $PROJECT_ROOT/splits_paper_seed42
DATA_ROOT    = $HAM_DATA_ROOT
OUTPUT_ROOT  = $PROJECT_ROOT/outputs_resnet50
HAM_GPU      = 0
folds        = [0, 1, 2]
  ok       $PROJECT_ROOT/splits_paper_seed42/global_train.csv
  ok       $PROJECT_ROOT/splits_paper_seed42/global_val.csv
  ok       $HAM_DATA_ROOT/HAM10000_metadata.csv
  ok       $PROJECT_ROOT/outputs_resnet50
  ok       $PROJECT_ROOT/outputs_resnet50/residual/cv_folds.csv
  nothing will be written under: $PROJECT_ROOT, $PROJECT_ROOT/outputs_resnet50, $PROJECT_ROOT/splits_paper_seed42, $HAM_DATA_ROOT, $HAM_MASK_DIR
  temporary files elsewhere are left to the libraries

device = cuda

[Debug][DataPath]
  DATA_ROOT=$HAM_DATA_ROOT
  METADATA_CSV=$HAM_DATA_ROOT/HAM10000_metadata.csv
  SPLIT_ROOT=$PROJECT_ROOT/splits_paper_seed42
