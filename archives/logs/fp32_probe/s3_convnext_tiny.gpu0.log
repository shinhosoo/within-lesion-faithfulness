[bb_run] backbone=convnext_tiny  output_root=$PROJECT_ROOT/outputs_convnext_tiny
PROJECT_ROOT = $PROJECT_ROOT   (the folder holding SkinCancer/)
SPLIT_ROOT   = $PROJECT_ROOT/splits_paper_seed42
DATA_ROOT    = $HAM_DATA_ROOT
OUTPUT_ROOT  = $PROJECT_ROOT/outputs_convnext_tiny
HAM_GPU      = 0
folds        = [0, 1, 2]
  ok       $PROJECT_ROOT/splits_paper_seed42/global_train.csv
  ok       $PROJECT_ROOT/splits_paper_seed42/global_val.csv
  ok       $HAM_DATA_ROOT/HAM10000_metadata.csv
  ok       $PROJECT_ROOT/outputs_convnext_tiny
  ok       $PROJECT_ROOT/outputs_convnext_tiny/residual/cv_folds.csv
  nothing will be written under: $PROJECT_ROOT, $PROJECT_ROOT/outputs_convnext_tiny, $PROJECT_ROOT/splits_paper_seed42, $HAM_DATA_ROOT, $HAM_MASK_DIR
  temporary files elsewhere are left to the libraries

device = cuda

