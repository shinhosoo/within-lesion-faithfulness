# Copy to env.sh and edit the four paths, then `. ./env.sh` before any command in the README.
# env.sh itself is not committed, because it holds paths particular to one machine.

# The HAM10000 distribution, holding HAM10000_images_part_1 and part_2. Not in this repository:
# the images are CC BY-NC. configs/data_config.py resolves the two folders without regard to
# case, since the distribution spells part_1 in upper case and part_2 in lower.
export HAM_DATA_ROOT=/path/to/HAM10000_extracted

# The Tschandl lesion masks, also CC BY-NC and also not here.
export HAM_MASK_DIR=/path/to/HAM10000_segmentations_lesion_tschandl

# This repository's splits/. These define the published partition; see the README on why
# regenerating them gives a different one.
export HAM_SPLIT_ROOT="$PWD/../splits"

# Where runs write. Nothing reads the archives in this repository through it; point it at an
# empty directory, or a clone of archives/outputs if you want to add to the measurements.
export HAM_OUTPUT_ROOT=/path/to/outputs

# The published configuration. The code's own defaults are HAM_AUGMENT=code and
# HAM_WEIGHT_DECAY=0.05, which are NOT what the paper reports: transforms.py defaults
# augmentation to the original code's recipe and training_config.py to weight decay 0.05, while
# the published runs used the manuscript's values. Set them explicitly or a clone reproduces
# neither.
export HAM_AUGMENT=paper
export HAM_WEIGHT_DECAY=5e-5

# Nested cross-validation. Unset or 0 chooses the training epoch on the same held-out fold that
# is then measured, which is what the main tables report; a fraction holds that much of the
# training fold back and trains the head on the rest, choosing the epoch on it, which is
# Table 3 of the main text.
# export HAM_INNER_VAL=0.15

# Which GPU. Takes precedence over CUDA_VISIBLE_DEVICES in the shell.
# export HAM_GPU=0
